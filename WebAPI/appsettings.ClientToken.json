{
  "ClientTokenSettings": {
    "SigningKey": "your-super-secret-client-token-signing-key-must-be-at-least-32-characters-long-for-security",
    "Issuer": "SYNFLOX-ClientAPI",
    "Audience": "SYNFLOX-Clients",
    "DefaultExpiryDays": 365,
    "MaxExpiryDays": 1095,
    "UseSubscriptionExpiry": true,
    "RateLimitPerHour": 1000,
    "RateLimitPerDay": 10000,
    "RateLimitPerMonth": 100000,
    "CleanupExpiredTokensAfterDays": 30,
    "CleanupUsageLogsAfterDays": 90,
    "RequireHttps": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "DefaultAllowedEndpoints": [
      "/api/client/subscription/status",
      "/api/client/license/validate",
      "/api/client/company/profile",
      "/api/client/auth/validate-token",
      "/api/client/health",
      "/api/client/usage/statistics",
      "/api/client/plan/features",
      "/api/client/subscription/history"
    ],
    "TokenVersion": "1.0",
    "AutoGenerateForNewSubscriptions": true,
    "RevokeOnSubscriptionInactive": true,
    "NotifyOnTokenExpiry": true,
    "NotifyDaysBeforeExpiry": 7,
    "EnableUsageAnalytics": true,
    "LogDetailedUsage": true,
    "AnalyticsRetentionDays": 365
  }
}
