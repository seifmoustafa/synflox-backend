# ===========================================
# SYNFLOX Backend Parent Repo .gitignore
# ===========================================

# Build outputs
bin/
obj/
out/

# User-specific files
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet packages
packages/
*.nupkg
project.lock.json
project.fragment.lock.json

# Local development files
.env
.env.local
.env.*.local

# IDE-specific files
.idea/
*.swp
*.sln.iml
*.DotSettings.user

# Logs
logs/
*.log

# Core project specific
/core/SYNFLOX.Core.WebAPI/FileHost/
/core/SYNFLOX.Core.Infrastructure/Migrations/

# Temporary files
*.tmp
*.temp
*.bak

# OS files
.DS_Store
Thumbs.db

# Test results
TestResults/
*.trx

# Coverage
coverage/
*.coverage
*.coveragexml